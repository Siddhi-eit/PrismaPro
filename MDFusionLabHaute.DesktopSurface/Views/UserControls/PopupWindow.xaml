<Window
    x:Class="MDFusionLabHaute.DesktopSurface.Views.UserControls.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PopupWindow"
    Width="700"
    Height="150"
    Background="Black"
    BorderBrush="White"
    BorderThickness="1"
    Foreground="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Label
                x:Name="txtNextDispenseMessage"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold" />
            <Button
                x:Name="btnContinue"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                Click="btnContinue_Click"
                Content="Continue"
                FontSize="25"
                Foreground="Black" />
        </StackPanel>
    </Grid>
</Window>
