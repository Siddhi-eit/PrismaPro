        <ListBox
            x:Name="ddlProductCode"
            Width="250"
            Height="160"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{x:Null}"
            BorderBrush="White"
            FontFamily="Neutraface Text Book"
            FontSize="20"
            Foreground="White"
            ItemsSource="{Binding}"
            KeyUp="DdlProductCode_KeyUp"
            SelectedIndex="0"
            Visibility="Hidden">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            x:Name="SmoothScrollViewer"
                            Grid.Row="0"
                            local:ListBoxHelper.IsSmoothScrollEnabled="True"
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid>
                                                    <Border
                                                        Width="{TemplateBinding Width}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Blue"
                                                        CornerRadius="10" />
                                                    <!--  Scroll handle  -->
                                                    <Thumb x:Name="PART_Thumb" Visibility="Collapsed" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!--  Up arrow  -->
                                        <RepeatButton
                                            x:Name="PART_LineUpButton"
                                            Grid.Row="0"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="22"
                                            Padding="0,0,0,1"
                                            Background="Transparent"
                                            Command="{x:Static ScrollBar.LineUpCommand}"
                                            Content="▲"
                                            Foreground="White"
                                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        <!--  ScrollContentPresenter  -->
                                        <ScrollContentPresenter Grid.Row="1" />
                                        <!--  Down arrow  -->
                                        <RepeatButton
                                            x:Name="PART_LineDownButton"
                                            Grid.Row="2"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="22"
                                            Padding="0,0,0,1"
                                            Background="Transparent"
                                            Command="{x:Static ScrollBar.LineDownCommand}"
                                            Content="▼"
                                            Foreground="White"
                                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>






