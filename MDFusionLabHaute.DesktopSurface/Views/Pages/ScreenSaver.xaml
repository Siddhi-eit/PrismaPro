<Page x:Class="MDFusionLabHaute.DesktopSurface.Views.Pages.ScreenSaver"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.Pages"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScreenSaver"  Foreground="White" Background="Black" >

    <Grid>
        <Grid.Background>
            <VisualBrush  AutoLayoutContent="True" Stretch="Uniform" Opacity="0.9" >
                <VisualBrush.Visual>
                    <Image gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Background-new (2).gif"
                   gif:ImageBehavior.AutoStart="True" 
                   gif:ImageBehavior.RepeatBehavior="1" AutomationProperties.IsOffscreenBehavior="Default" OpacityMask="{x:Null}" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <!-- Default Images -->
        <Image x:Name="imgCenter" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 7.png" Height="300" Width="600"/>
        <Image x:Name="imgSidebar" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Stretch" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png"/>
        <Image x:Name="imgLogo" HorizontalAlignment="Right" Margin="693,15,15,0" VerticalAlignment="Top" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" Width="275" Height="275"/>

        <Image x:Name="imgLoader" Source="/Views/Resources/Images/Menu-Selected.png" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Top="100" Canvas.Left="50" 
        RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform x:Name="MyAnimatedRotateTransform" Angle="0" />
            </Image.RenderTransform>
        </Image>

        <!--<TextBlock Canvas.Top="100" Canvas.Left="50" HorizontalAlignment="Center" VerticalAlignment="Center"
        TextAlignment="Center" FontSize="16pt" Foreground="#CCCCFF"
        RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <RotateTransform x:Name="MyAnimatedRotateTransform" Angle="0" />
            </TextBlock.RenderTransform>
        RotateTransform
        </TextBlock>-->

    </Grid>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation 
            Storyboard.TargetName="MyAnimatedRotateTransform" 
            Storyboard.TargetProperty="Angle" 
            From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>