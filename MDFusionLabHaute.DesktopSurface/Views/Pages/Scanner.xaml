<Page x:Class="MDFusionLabHaute.DesktopSurface.Views.Pages.Scanner"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.Pages"
      xmlns:materialDesign="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:gif="http://wpfanimatedgif.codeplex.com" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Scanner" Background="Black">

    <Grid>
        <Grid.Background>
            <VisualBrush  Stretch="None" >
                <VisualBrush.Visual>
                    <Image gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Background-new (2)-old.gif"
                   gif:ImageBehavior.AutoStart="True" 
                   gif:ImageBehavior.RepeatBehavior="1" AutomationProperties.IsOffscreenBehavior="Default" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>
        
        <!-- Default Images -->
        <Image x:Name="imgCenter" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 7.png" Height="300" Width="600"/>
        <Image x:Name="imgSidebar" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Stretch" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png"/>
        <Image x:Name="imgLogo" HorizontalAlignment="Right" Margin="693,15,15,0" VerticalAlignment="Top" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" Width="275" Height="275"/>

        <!-- Video Devices Dropdowns -->
        <Label x:Name="lblVideoDevices" Visibility="Hidden" Content="VIDEO DEVICES" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,150" FontFamily="Neutraface Text Book" FontSize="25" Foreground="#FFFFFF"/>
        <ComboBox x:Name="ddlVideoDevices" SelectedIndex="0" Visibility="Hidden" IsEditable="False" Text="--SELECT VIDEO DEVICES--" ItemsSource="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" BorderBrush="{x:Null}" Background="Gray" Foreground="White" />

        <!-- Product Formula Grid -->
        <Image x:Name="imgCenterTop" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 8.png" Height="150" Width="500" Margin="0,0,0,300"/>
        <Image x:Name="imgCenterBtootm" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 9.png" Height="150" Width="500" Margin="0,300,0,0"/>
        <Label x:Name="lblScan" Visibility="Hidden" Content="SCANNING..." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,350" FontFamily="Neutraface Text Book" FontSize="16"/>
        <Image x:Name="imgScanner" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="250" ></Image>

        <!-- Footer -->
        <Grid x:Name="grdFooter" HorizontalAlignment="Stretch" Height="70" Margin="5,5,0,0" VerticalAlignment="Bottom" Width="500">
            <Image x:Name="imgFooterActions" Margin="5,5,5,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 4.png"/>
            <Button x:Name="btnBack" HorizontalAlignment="Center" Height="60" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" VerticalAlignment="Top" Foreground="White" Margin="0,0,250,10" FontFamily="Neutraface Text Book" FontSize="16" Click="btnBack_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lblbtnBack" Text="BACK" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Image Source="/Views/Resources/Images/Menu.png" Width="40" Height="40"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnNext" HorizontalAlignment="Center" Height="60" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" VerticalAlignment="Top" Foreground="White" Margin="250,0,0,10" FontFamily="Neutraface Text Book" FontSize="16" Click="btnNext_Click" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="lblbtnNext" Text="NEXT" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Image Source="/Views/Resources/Images/Menu.png" Width="40" Height="40"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Notification Bar -->
        <materialDesign:Snackbar x:Name="MySnackbar" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="500" FontFamily="Neutraface Text Bold" FontSize="16"  />

        <!-- Loader -->
        <DockPanel x:Name="Loader" Visibility="Hidden" Panel.ZIndex="98" >
            <DockPanel.Background>
                <SolidColorBrush Color="#FFF3ECEC" Opacity="0.5"/>
            </DockPanel.Background>
            <materialDesign:ProgressRing x:Name="loading" IsIndeterminate="True" Progress="80" HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50" Foreground="White" Panel.ZIndex="99" />
        </DockPanel>
    </Grid>
</Page>
