<Page x:Class="MDFusionLabHaute.DesktopSurface.Views.Pages.Dispense"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.Pages"
      xmlns:materialDesign="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:gif="http://wpfanimatedgif.codeplex.com" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dispense" Foreground="White" Background="Black">

    <Grid>
        <Grid.Background>
            <VisualBrush  AutoLayoutContent="True" Stretch="Uniform" Opacity="0.5" >
                <VisualBrush.Visual>
                    <Image gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Background-new (2).gif"
                   gif:ImageBehavior.AutoStart="True" 
                   gif:ImageBehavior.RepeatBehavior="1" AutomationProperties.IsOffscreenBehavior="Default" OpacityMask="{x:Null}" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>
        
        <!-- Sanitization Dialogue  -->
        <materialDesign:Dialog
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="CanisterAlertDialog"
            ButtonLeftName="Refill Now"
            ButtonLeftClick="CanisterAlertDialog_OnButtonLeftClick"
            ButtonRightName="OK"
            ButtonRightClick="CanisterAlertDialog_OnButtonRightClick"
            DialogWidth="600"
            DialogHeight="400"
             Panel.ZIndex="999" FontFamily="Neutraface Text Book" Foreground="White">
            <Grid>
                <StackPanel>
                    <TextBlock FontWeight="Medium" Text="CANISTER ALERT" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Visibility="Hidden"
                            Text="Please sanitize canister."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Justify"
                            TextWrapping="WrapWithOverflow" Margin="0,15,0,0" />
                    <materialDesign:SymbolIcon Symbol="ErrorCircleSettings20" FontSize="36" Foreground="Red"/>
                    <StackPanel x:Name="pnlCanisterAlertDialogText" HorizontalAlignment="Center" Margin="0,10,0,0" ></StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Dialog>

        <!-- Default Images -->
        <materialDesign:Dialog>
        </materialDesign:Dialog>

        <!-- Default Images -->
        <Image x:Name="imgCenter" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 7.png" Height="300" Width="600"/>
        <Image x:Name="imgSidebar" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Stretch" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png"/>
        <Image x:Name="imgLogo" HorizontalAlignment="Right" Margin="693,15,15,0" VerticalAlignment="Top" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" Width="275" Height="275"/>

        <!-- Product Formula Dropdowns -->
        <Label x:Name="lblProductFormula" Visibility="Hidden" Content="PRODUCT FORMULA COMBINATION" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,150" FontFamily="Neutraface Text Book" FontSize="16"/>
        <!--<ComboBox x:Name="ddlProductCode" SelectedIndex="0" Visibility="Hidden" IsEditable="False" Text="SELECT PRODUCT CODE" ItemsSource="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" Margin="0,0,650,0" Foreground="White" SelectionChanged="ddlProductCode_SelectionChanged"  />-->
        <!--<ComboBox x:Name="ddlProductCollection" SelectedIndex="0" Visibility="Hidden"  IsEditable="False" ItemsSource="{Binding}" Text="SELECT PRODUCT COLLECTION" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" BorderBrush="{x:Null}"  Foreground="White" SelectionChanged="ddlProductCollection_SelectionChanged"  />-->
        <ComboBox x:Name="ddlProductName" SelectedIndex="0" Visibility="Hidden" IsEditable="False" ItemsSource="{Binding}" Text="--SELECT PRODUCT NAME--" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" Margin="650,0,0,0" BorderBrush="{x:Null}" Foreground="White"  SelectionChanged="ddlProductName_SelectionChanged"  />

        <!-- Product Formula Grid -->
        <Image x:Name="imgCenterTop" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 8.png" Height="300" Width="600" Margin="0,0,0,300"/>
        <Image x:Name="imgCenterBtootm" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 9.png" Height="300" Width="600" Margin="0,300,0,0"/>
        <Label x:Name="lblProductFormulaCollection" Visibility="Hidden" Content="PRODUCT FORMULA COLLECTION" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,350" FontFamily="Neutraface Text Book" FontSize="16"/>
        <DataGrid  Margin="10,10,10,10" SelectionMode="Single" IsReadOnly="True" x:Name="grdColorFormula" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Height="200" MinWidth="900" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Neutraface Text Book" Background="#FF1A1A1A" BorderBrush="#FF4E4E4E" Foreground="White" Padding="10,10,10,10" MinColumnWidth="150" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" ></DataGrid>

        <!-- Cane Size -->
        <Label x:Name="lblCaneSize" Visibility="Hidden" Content="CAN SIZE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,150" FontFamily="Neutraface Text Book" FontSize="16"/>
        <ComboBox x:Name="ddlCanSize" SelectedIndex="0" Visibility="Hidden" IsEditable="False" Text="--SELECT CAN SIZE--" ItemsSource="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" BorderBrush="{x:Null}" Background="Gray" Foreground="White"  />

        <!-- Dispense Unit -->
        <Label x:Name="lblDispenseUnit" Visibility="Hidden" Content="DISPENSE UNIT" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,150" FontFamily="Neutraface Text Book" FontSize="16"/>
        <ComboBox x:Name="ddlDispenseUnit" SelectedIndex="0" Visibility="Hidden" IsEditable="False" Text="--SELECT DISPENSE UNIT--" ItemsSource="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="38" FontSize="16" FontFamily="Neutraface Text Book" BorderBrush="{x:Null}" Background="Gray" Foreground="White"  />

        <!-- Footer -->
        <Grid x:Name="grdFooter" HorizontalAlignment="Stretch" Height="70" Margin="5,5,0,10" VerticalAlignment="Bottom" Width="500">
            <Image x:Name="imgFooterActions" Margin="5,5,5,5" VerticalAlignment="Center" HorizontalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 4.png"/>
            <Button x:Name="btnSubmit" Visibility="Hidden" Content="SUBMIT" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" Margin="250,10,0,10" BorderBrush="{x:Null}" Background="{x:Null}" FontFamily="Neutraface Text Book" FontSize="16" Click="btnSubmit_Click" />
            <Button x:Name="btnBack" Content="BACK" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" Margin="0,10,250,10" Background="{x:Null}" FontFamily="Neutraface Text Book" FontSize="16" Click="btnBack_Click" BorderBrush="{x:Null}"/>
            <Button x:Name="btnNext" Content="NEXT" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="White" Margin="250,10,0,10" BorderBrush="{x:Null}" Background="{x:Null}" FontFamily="Neutraface Text Book" FontSize="16" Click="btnNext_Click" />
        </Grid>

        <!-- Notification Bar -->
        <materialDesign:Snackbar x:Name="MySnackbar" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="500" FontFamily="Neutraface Text Bold" FontSize="16"  />

        <!-- Loader -->
        <DockPanel x:Name="Loader" Visibility="Hidden" Panel.ZIndex="98" >
            <DockPanel.Background>
                <SolidColorBrush Color="#FFF3ECEC" Opacity="0.5"/>
            </DockPanel.Background>
            <materialDesign:ProgressRing x:Name="loading" IsIndeterminate="True" Progress="80" HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50" Foreground="White" Panel.ZIndex="99" />
        </DockPanel>
    </Grid>
</Page>