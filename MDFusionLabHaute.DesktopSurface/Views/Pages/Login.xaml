<Page
    x:Class="MDFusionLabHaute.DesktopSurface.Views.Pages.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.Pages"
    xmlns:materialDesign="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:z="clr-namespace:MDFusionLabHaute.DesktopSurface.LanguageResources"
    Title="Login"
    d:DesignHeight="1824"
    d:DesignWidth="2736"
    Background="Black"
    Foreground="White"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <VisualBrush Stretch="None">
                <VisualBrush.Visual>
                    <Image
                        gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Background-new (2)-old.gif"
                        gif:ImageBehavior.AutoStart="True"
                        gif:ImageBehavior.RepeatBehavior="1"
                        AutomationProperties.IsOffscreenBehavior="Default" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <!--  Loader  -->
        <Image
            x:Name="Loader"
            Canvas.Left="50"
            Canvas.Top="100"
            Width="130"
            Height="130"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Source="/Views/Resources/Images/Menu-Selected.png"
            Visibility="Hidden">
            <Image.RenderTransform>
                <RotateTransform x:Name="MyAnimatedRotateTransform" Angle="0" />
            </Image.RenderTransform>
        </Image>

        <!--#region Body-->

        <!--  Default Images  -->
        <Image
            x:Name="imgCenterTop"
            Width="500"
            Height="150"
            Margin="0,0,0,145"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 8.png" />
        <Image
            x:Name="imgCenterBottom"
            Width="500"
            Height="150"
            Margin="0,145,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 9.png" />
        <!--<Image x:Name="imgCenter" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 7.png" Width="400" Height="150"/>-->
        <Image
            x:Name="imgSidebar"
            Margin="10,10,0,10"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png" />
        <Image
            x:Name="imgLogo"
            Width="275"
            Height="275"
            Margin="693,15,15,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" />

        <materialDesign:Snackbar
            x:Name="MySnackbar"
            MinWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontFamily="Neutraface Text Bold"
            FontSize="20" />

        <!--  Email  -->
        <Label
            x:Name="lblEmail"
            Margin="0,0,0,150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="EMAIL ACCOUNT"
            FontFamily="Neutraface Text Book"
            FontSize="25"
            Visibility="Hidden" />
        <TextBox
            x:Name="txtEmailID"
            Width="350"
            Height="38"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CharacterCasing="Upper"
            FontFamily="Neutraface Text Book"
            FontSize="25"
            KeyUp="txtEmailID_KeyUp"
            TextWrapping="Wrap"
            Visibility="Hidden" />

        <!--  Password  -->
        <Label
            x:Name="lblPassword"
            Margin="0,0,0,150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="PASSWORD"
            FontFamily="Neutraface Text Book"
            FontSize="25"
            Visibility="Hidden" />
        <PasswordBox
            x:Name="txtPassword"
            Width="350"
            Height="38"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Neutraface Text Book"
            FontSize="25"
            KeyUp="txtPassword_KeyUp"
            Visibility="Hidden" />

        <!--  Footer  -->
        <Grid
            x:Name="grdFooter"
            Width="500"
            Height="70"
            Margin="5,5,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <Image
                x:Name="imgFooterActions"
                Margin="5,5,5,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 4.png" />
            <Button
                x:Name="btnExit"
                Height="60"
                Margin="0,0,300,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="btnExit_Click"
                FontSize="20"
                Foreground="White"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="Neutraface Text Book"
                        FontSize="30"
                        Foreground="#FFFFFF"
                        Text="EXIT" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="/Views/Resources/Images/Glob-InActive.png" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnNext"
                Height="60"
                Margin="300,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="btnNext_Click"
                FontSize="20"
                Foreground="White"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="Neutraface Text Book"
                        FontSize="30"
                        Foreground="#FFFFFF"
                        Text="NEXT" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="/Views/Resources/Images/Glob-InActive.png" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnBack"
                Height="60"
                Margin="0,0,300,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="btnBack_Click"
                FontSize="20"
                Foreground="White"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="Neutraface Text Book"
                        FontSize="30"
                        Foreground="#FFFFFF"
                        Text="BACK" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="/Views/Resources/Images/Glob-InActive.png" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnSubmit"
                Height="60"
                Margin="300,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="btnSubmit_Click"
                FontSize="20"
                Foreground="White"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="Neutraface Text Book"
                        FontSize="30"
                        Foreground="#FFFFFF"
                        Text="SUBMIT" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="/Views/Resources/Images/Glob-InActive.png" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="MyAnimatedRotateTransform"
                        Storyboard.TargetProperty="Angle"
                        From="0"
                        To="360"
                        Duration="0:0:5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

</Page>