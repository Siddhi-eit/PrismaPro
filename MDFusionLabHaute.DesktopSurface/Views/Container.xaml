<Window
    x:Class="MDFusionLabHaute.DesktopSurface.Views.Container"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MDFusionLabHaute.DesktopSurface.Views.Pages"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Container"
    d:DesignHeight="1824"
    d:DesignWidth="2736"
    Background="Black"
    FontFamily="Neutraface Text Book"
    Foreground="White"
    Icon="/Views/Resources/Images/Group-2.png"
    ResizeMode="NoResize"
    Style="{DynamicResource UiWindow}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <wpfui:NavigationCompact
            x:Name="RootNavigation"
            Grid.Column="0"
            Frame="{Binding ElementName=RootFrame}"
            SelectedPageIndex="0"
            Visibility="Collapsed">
            <wpfui:NavigationCompact.Items>
                <!--<wpfui:NavigationItem x:Name="navDashboard"
                    Content="Dashboard"
                    Icon="Apps24"
                    Page="{x:Type pages:Dashboard}"
                    PageTag="Dashboard"  FontFamily="Neutraface Text Book" />-->
                <wpfui:NavigationItem
                    x:Name="navLogin"
                    Content="Login"
                    FontFamily="Neutraface Text Book"
                    Icon="Apps24"
                    Page="{x:Type pages:Login}"
                    PageTag="Login" />
                <wpfui:NavigationItem
                    x:Name="navCustomDispense"
                    Content="CustomDispense"
                    FontFamily="Neutraface Text Book"
                    Icon="Apps24"
                    Page="{x:Type pages:CustomDispense}"
                    PageTag="CustomDispense" />
                <wpfui:NavigationItem
                    x:Name="navDispense"
                    Content="Dispense"
                    Icon="ColorBackground24"
                    Page="{x:Type pages:Dispense}"
                    PageTag="Dispense" />
                <wpfui:NavigationItem
                    x:Name="navScanner"
                    Content="Scanner"
                    FontFamily="Neutraface Text Book"
                    Icon="BarcodeScanner24"
                    Page="{x:Type pages:Scanner}"
                    PageTag="Scanner" />
            </wpfui:NavigationCompact.Items>
            <wpfui:NavigationCompact.Footer>
                <wpfui:NavigationItem
                    Click="NavigationItem_Click"
                    Content="Logout"
                    FontFamily="Neutraface Text Book"
                    Icon="ArrowExit20"
                    PageTag="settings" />
            </wpfui:NavigationCompact.Footer>
        </wpfui:NavigationCompact>

        <wpfui:TitleBar
            x:Name="lblTitle"
            Title="MDFusionLab-Haute"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="42,0,0,0" />

        <Grid Grid.Column="1">
            <!--  Loader  -->
            <DockPanel
                x:Name="Loader"
                Panel.ZIndex="98"
                Visibility="Hidden">
                <DockPanel.Background>
                    <SolidColorBrush Opacity="0.5" Color="#FFF3ECEC" />
                </DockPanel.Background>
                <wpfui:ProgressRing
                    x:Name="loading"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="99"
                    Foreground="White"
                    IsIndeterminate="True"
                    Progress="80" />
            </DockPanel>

            <!--  Sanitization Dialogue  -->
            <wpfui:Dialog
                x:Name="SanitizationDialog"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="999"
                ButtonLeftClick="SanitizationDialog_OnButtonLeftClick"
                ButtonLeftName="SCHEDULE IT ON TOMORROW"
                ButtonRightClick="SanitizationDialog_OnButtonRightClick"
                ButtonRightName="OK"
                DialogHeight="400"
                DialogWidth="600"
                FontFamily="Neutraface Text Book"
                IsShown="False">
                <Grid>
                    <StackPanel>
                        <wpfui:SymbolIcon
                            FontSize="56"
                            Foreground="Red"
                            Symbol="ErrorCircleSettings20" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Medium"
                            Text="SANITIZATION ALERT" />
                        <TextBlock
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="Please sanitize canister."
                            TextAlignment="Justify"
                            TextWrapping="WrapWithOverflow"
                            Visibility="Hidden" />
                        <StackPanel
                            x:Name="pnlSanitizationDialogText"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </wpfui:Dialog>

            <!--  Sanitization Dialogue  -->
            <wpfui:Dialog
                x:Name="RefillDialog"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="999"
                ButtonLeftVisibility="Hidden"
                ButtonRightAppearance="Primary"
                ButtonRightClick="RefllDialog_OnButtonRightClick"
                ButtonRightName="OK"
                DialogHeight="400"
                DialogWidth="600"
                IsShown="False">
                <Grid>
                    <StackPanel>
                        <wpfui:SymbolIcon
                            FontSize="56"
                            Foreground="Red"
                            Symbol="ErrorCircleSettings20" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Medium"
                            Text="REFILL ALERT" />
                        <TextBlock
                            x:Name="lblRefllDialogtext"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Text="Please refill canister."
                            TextAlignment="Justify"
                            TextWrapping="WrapWithOverflow"
                            Visibility="Hidden" />
                        <StackPanel
                            x:Name="pnlRefillDialogText"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </wpfui:Dialog>

            <Border
                Margin="0,46,0,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Frame
                        x:Name="RootFrame"
                        Grid.Row="1"
                        Margin="4,8" />
                </Grid>
            </Border>

            <!--  Notification Bar  -->
            <wpfui:Snackbar
                x:Name="MySnackbar"
                MinWidth="500"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontFamily="Neutraface Text Bold"
                FontSize="15" />

        </Grid>
    </Grid>
</Window>