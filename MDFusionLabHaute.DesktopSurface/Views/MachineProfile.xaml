<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    x:Class="MDFusionLabHaute.DesktopSurface.Views.MachineProfile"
    mc:Ignorable="d"
    d:DesignHeight="2024" d:DesignWidth="2736"
    Foreground="White" Background="Black"
    Title="MachineProfile"
    Style="{DynamicResource UiWindow}"
    WindowState="Maximized"
    ResizeMode="NoResize"
    FontFamily="Neutraface Text Book"
    FontSize="16"
    Icon="/Views/Resources/Images/Group-2.png"
    WindowStartupLocation="CenterScreen" >

    <Grid x:Name="grdMain">
        <Grid.Background>
            <VisualBrush Stretch="UniformToFill">
                <VisualBrush.Visual>
                    <Image gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Untitled design.gif"
                           gif:ImageBehavior.AutoStart="True"
                           gif:ImageBehavior.RepeatBehavior="1"
                           AutomationProperties.IsOffscreenBehavior="Default" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <!-- Default Images -->
        <Image x:Name="imgSidebar" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Stretch"
               gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png" />
        <Image x:Name="imgLogo" HorizontalAlignment="Right" Margin="693,15,15,0" VerticalAlignment="Top"
               gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" Width="275" Height="275" />

        <!-- Content Placeholder -->
        <!-- Header -->
        <TextBlock x:Name="lblMachineProfile" Text="MACHINE PROFILE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" Grid.Row="0" Margin="0,0,0,330"/>

        <!-- Content -->
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Content -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ProfilePanel" Grid.Column="1" Orientation="Vertical" Width="300">
                    <!-- Machine Registration Number -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBox x:Name="txtMachineRegNo" TabIndex="1" Width="250" FontSize="12" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#2B2B2B" Background="#1E1E1E" Foreground="#FFFFFF" Height="20" TextChanged="txtMachineRegNo_TextChanged"  >
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBox  x:Name="txtMachineRegNoValues" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Height="{TemplateBinding Height}"  />
                                        <TextBlock x:Name="txtMachineRegNoPlaceholder" Text="MACHINE REGISTRATION NUMBER" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False" />
                                                <Condition Binding="{Binding ElementName=txtMachineRegNo, Path=Text.Length}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="txtMachineRegNoPlaceholder" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBox x:Name="txtShopName" TabIndex="2" Width="250" FontSize="12" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#2B2B2B" Background="#1E1E1E" Foreground="#FFFFFF" Height="20" TextChanged="txtShopName_TextChanged" >
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBox x:Name="txtShopNameValues" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Height="{TemplateBinding Height}"/>
                                        <TextBlock x:Name="txtShopNamePlaceholder" Text="SHOP NAME" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False" />
                                                <Condition Binding="{Binding ElementName=txtShopName, Path=Text.Length}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="txtShopNamePlaceholder" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBox x:Name="txtShopAddress" TabIndex="3" Width="250" FontSize="12" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#2B2B2B" Background="#1E1E1E" Foreground="#FFFFFF" Height="20" TextChanged="txtShopAddress_TextChanged" >
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBox x:Name="txtShopAddressValues" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Height="{TemplateBinding Height}"/>
                                        <TextBlock x:Name="txtShopAddressPlaceholder" Text="SHOP ADDRESS" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False" />
                                                <Condition Binding="{Binding ElementName=txtShopAddress, Path=Text.Length}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="txtShopAddressPlaceholder" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBox x:Name="txtCity" TabIndex="4" Width="250" FontSize="12" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#2B2B2B" Background="#1E1E1E" Foreground="#FFFFFF" Height="20" TextChanged="txtCity_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBox x:Name="txtCityValues" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Height="{TemplateBinding Height}"/>
                                        <TextBlock x:Name="txtCityPlaceholder" Text="CITY" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False" />
                                                <Condition Binding="{Binding ElementName=txtCity, Path=Text.Length}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="txtCityPlaceholder" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBox x:Name="txtState" TabIndex="5" Width="250" FontSize="12" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#2B2B2B" Background="#1E1E1E" Foreground="#FFFFFF" Height="20" TextChanged="txtState_TextChanged" >
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBox x:Name="txtStateValues" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Height="{TemplateBinding Height}"/>
                                        <TextBlock x:Name="txtStatePlaceholder" Text="STATE" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False" />
                                                <Condition Binding="{Binding ElementName=txtState, Path=Text.Length}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="txtStatePlaceholder" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,230,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnSubmit" Content="SAVE" Width="290" Height="32" FontSize="18" FontWeight="Bold" Background="#007ACC" Foreground="White" BorderThickness="0" Click="btnSubmit_Click" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Notification Bar -->
        <ui:Snackbar x:Name="MySnackbar" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="500" FontFamily="Neutraface Text Bold" FontSize="16"  />

        <!-- Loader -->
        <DockPanel Name="Loader" Visibility="Hidden" Panel.ZIndex="98" >
            <ui:ProgressRing x:Name="loading" IsIndeterminate="True" Progress="80" HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="50" Foreground="White" Panel.ZIndex="99" />
            <DockPanel.Background>
                <SolidColorBrush Color="#FFF3ECEC" Opacity="0.5"/>
            </DockPanel.Background>
        </DockPanel>
    </Grid>
</Window>
