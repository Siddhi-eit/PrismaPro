<Window x:Class="MDFusionLabHaute.DesktopSurface.Views.LockScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDFusionLabHaute.DesktopSurface.Views"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="LockScreen" Height="450" Width="800" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen" WindowState="Maximized" Cursor="" Foreground="White" Background="Black" Icon="/Views/Resources/Images/Group-2.png" >
    <Grid>
        <!-- Default Images -->
        <Image x:Name="imgLogo" HorizontalAlignment="Right" Margin="693,15,15,0" VerticalAlignment="Top" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 6.png" Width="275" Height="275"/>
        <Image x:Name="imgSidebar" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Stretch" gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Asset 5.png"/>
        <Grid.Background>
            <VisualBrush  AutoLayoutContent="True" Stretch="Uniform" Opacity="0.9" >
                <VisualBrush.Visual>
                    <Image gif:ImageBehavior.AnimatedSource="/Views/Resources/Images/Background-new (2).gif"
                   gif:ImageBehavior.AutoStart="True" 
                   gif:ImageBehavior.RepeatBehavior="1" AutomationProperties.IsOffscreenBehavior="Default" OpacityMask="{x:Null}" />
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

    </Grid>
</Window>
